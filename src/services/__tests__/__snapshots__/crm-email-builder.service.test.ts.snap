 width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="margin:0 0 12px"><tbody style="width:100%"><tr style="width:100%"><td data-id="__react-email-column" style="width:40px;vertical-align:top"><p style="font-size:13px;line-height:28px;margin:0;width:28px;height:28px;border-radius:14px;text-align:center;font-weight:700;background-color:#e5f2f9;color:#2893CC;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">2</p></td><td data-id="__react-email-column" style="vertical-align:top"><p style="font-size:16px;line-height:24px;margin:0;font-weight:600;color:#14171E;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">Integrações</p><p style="font-size:14px;line-height:22px;margin:2px 0 0;color:#43454B;margin-top:2px;margin-right:0;margin-bottom:0;margin-left:0">Conecta com as ferramentas que você já usa.</p></td></tr></tbody></table><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="margin:0 0 12px"><tbody style="width:100%"><tr style="width:100%"><td data-id="__react-email-column" style="width:40px;vertical-align:top"><p style="font-size:13px;line-height:28px;margin:0;width:28px;height:28px;border-radius:14px;text-align:center;font-weight:700;background-color:#e5f2f9;color:#2893CC;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">3</p></td><td data-id="__react-email-column" style="vertical-align:top"><p style="font-size:16px;line-height:24px;margin:0;font-weight:600;color:#14171E;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">Suporte dedicado</p><p style="font-size:14px;line-height:22px;margin:2px 0 0;color:#43454B;margin-top:2px;margin-right:0;margin-bottom:0;margin-left:0">Gente de verdade para ajudar.</p></td></tr></tbody></table></td></tr></tbody></table><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation"><tbody><tr><td style="padding:16px 40px"><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="border-left:4px solid #2893CC"><tbody><tr><td style="padding:4px 0 4px 20px"><p style="font-size:18px;line-height:28px;margin:0;font-style:italic;color:#14171E;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">“<!-- -->Reduzimos pela metade o tempo de atendimento na primeira semana.<!-- -->”</p><p style="font-size:13px;line-height:20px;margin:12px 0 0;color:#7B7D81;margin-top:12px;margin-right:0;margin-bottom:0;margin-left:0"><strong style="color:#43454B">Ana Souza</strong> — Diretora de operações</p></td></tr></tbody></table></td></tr></tbody></table><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="text-align:center"><tbody><tr><td style="padding:16px 40px"><a href="https://acme.com.br/lp?utm_source=email" style="line-height:100%;text-decoration:none;display:inline-block;max-width:100%;mso-padding-alt:0px;background-color:#2893CC;color:#FFFFFF;border-radius:8px;padding:12px 24px;font-size:15px;font-weight:600;padding-top:12px;padding-right:24px;padding-bottom:12px;padding-left:24px" target="_blank"><span><!--[if mso]><i style="mso-font-width:400%;mso-text-raise:18px" hidden>&#8202;&#8202;&#8202;</i><![endif]--></span><span style="max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:9px">Quero conhecer</span><span><!--[if mso]><i style="mso-font-width:400%" hidden>&#8202;&#8202;&#8202;&#8203;</i><![endif]--></span></a></td></tr></tbody></table><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation"><tbody><tr><td style="padding:8px 40px 32px"><hr style="width:100%;border:none;border-color:#E4E4E7;border-top:1px solid #eaeaea;margin:8px 0 20px"/><p style="font-size:12px;line-height:18px;margin:0 0 6px;color:#43454B;text-align:center;font-weight:600;margin-top:0;margin-right:0;margin-bottom:6px;margin-left:0">Acme</p><p style="font-size:12px;line-height:18px;margin:0 0 6px;color:#7B7D81;text-align:center;margin-top:0;margin-right:0;margin-bottom:6px;margin-left:0">Rua das Flores, 10</p><p style="font-size:12px;line-height:18px;margin:0 0 6px;color:#7B7D81;text-align:center;margin-top:0;margin-right:0;margin-bottom:6px;margin-left:0"><a href="https://acme.com.br" style="color:#7B7D81;text-decoration-line:none" target="_blank">acme.com.br</a></p><p style="font-size:12px;line-height:18px;margin:12px 0 0;color:#7B7D81;text-align:center;margin-top:12px;margin-right:0;margin-bottom:0;margin-left:0">Você recebeu este e-mail porque está na base de contatos de<!-- --> <!-- -->Acme<!-- -->. Não quer mais receber?<!-- --> <a href="https://steel.test/unsubscribe/tok" data-unsubscribe="true" style="color:#7B7D81;text-decoration-line:none;text-decoration:underline" target="_blank">Descadastrar</a>.</p></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>"`;

exports[`renderCampaignEmail() > renders the anuncio-produto layout for a contact (snapshot) > text 1`] = `
"Acme

Lançamento


Apresentamos o novo produto

Mais rápido, mais simples e feito a partir do que nossos clientes pediram.

Conhecer agora https://acme.com.br/lp?utm_source=email


Por que ele é diferente

Explique em poucas linhas o problema que o produto resolve.


Recursos

1

Configuração em minutos

Sem instalação e sem treinamento.

2

Integrações

Conecta com as ferramentas que você já usa.

3

Suporte dedicado

Gente de verdade para ajudar.

“Reduzimos pela metade o tempo de atendimento na primeira semana.”

Ana Souza — Diretora de operações

Quero conhecer https://acme.com.br/lp?utm_source=email

----------------------------------------

Acme

Rua das Flores, 10

acme.com.br https://acme.com.br

Você recebeu este e-mail porque está na base de contatos de Acme. Não quer mais receber? Descadastrar https://steel.test/unsubscribe/tok."
`;

exports[`renderCampaignEmail() > renders the boas-vindas layout for a contact (snapshot) > html 1`] = `"<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html dir="ltr" lang="pt-BR"><head><meta content="text/html; charset=UTF-8" http-equiv="Content-Type"/><meta name="x-apple-disable-message-reformatting"/><title>Oi João</title><meta name="color-scheme" content="light"/><meta name="supported-color-schemes" content="light"/><title>Que bom ter você com a gente. Veja por onde começar.</title></head><body dir="ltr" lang="en" style="background-color:#F3F4F6;margin:0;padding:0"><!--$--><!--html--><!--head--><div style="display:none;overflow:hidden;line-height:1px;opacity:0;max-height:0;max-width:0" data-skip-in-text="true">Que bom ter você com a gente. Veja por onde começar.<div> ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿</div></div><!--body--><table border="0" width="100%" cellPadding="0" cellSpacing="0" role="presentation" ali