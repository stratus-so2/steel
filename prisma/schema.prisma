generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  username            String               @unique
  emailVerified       Boolean              @default(false) @map("email_verified")
  image               String?
  coverImage          String?              @map("cover_image")
  twoFactorEnabled    Boolean              @default(false) @map("two_factor_enabled")
  isPlatformAdmin     Boolean              @default(false) @map("is_platform_admin")
  deletionScheduledAt DateTime?            @map("deletion_scheduled_at")
  acceptedTermsAt     DateTime?            @map("accepted_terms_at")
  acceptedPrivacyAt   DateTime?            @map("accepted_privacy_at")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  onboardingStep      OnboardingStep?      @default(PROFILE) @map("onboarding_step")
  role                UserRole?            @map("role")
  goals               UserGoal[]           @map("goals")
  preference          UserPreference?
  notificationSetting NotificationSetting?

  memberships              Membership[]
  sessions                 Session[]
  accounts                 Account[]
  twoFactors               TwoFactor[]
  shortLinks               ShortLink[]
  stickyNotes              StickyNote[]
  consentEvents            ConsentEvent[]
  projectsLed              Project[]                   @relation("ProjectLead")
  projectMemberships       ProjectMember[]
  projectFavourites        ProjectFavorite[]
  sentInvitations          WorkspaceInvitation[]       @relation("SentInvitations")
  moduleConnectionsCreated WorkspaceModuleConnection[]
  moduleAccessGranted      WorkspaceModuleAccess[]

  changelogsCreated  Changelog[]
  changelogRecipient ChangelogRecipient[]

  whatsappConnectionsCreated          WhatsAppConnection[]          @relation("WhatsAppConnectionCreatedBy")
  whatsappConversationsAssigned       WhatsAppConversation[]        @relation("WhatsAppConversationAssignee")
  whatsappMessagesSent                WhatsAppMessage[]             @relation("WhatsAppMessageSender")
  whatsappBroadcastsCreated           WhatsAppBroadcastList[]       @relation("WhatsAppBroadcastCreatedBy")
  whatsappGroupMessagesSent           WhatsAppGroupMessage[]        @relation("WhatsAppGroupMessageSender")
  whatsappAiKnowledgeDocumentsCreated WhatsAppAiKnowledgeDocument[] @relation("WhatsAppAiKnowledgeDocumentCreatedBy")

  crmCompaniesCreated          CrmCompany[]               @relation("CrmCompanyCreatedBy")
  crmCompaniesOwned            CrmCompany[]               @relation("CrmCompanyAccountOwner")
  crmCompaniesUpdated          CrmCompany[]               @relation("CrmCompanyUpdatedBy")
  crmPeopleCreated             CrmPerson[]                @relation("CrmPersonCreatedBy")
  crmPeopleUpdated             CrmPerson[]                @relation("CrmPersonUpdatedBy")
  crmPipelinesCreated          CrmPipeline[]              @relation("CrmPipelineCreatedBy")
  crmPipelinesUpdated          CrmPipeline[]              @relation("CrmPipelineUpdatedBy")
  crmProductsCreated           CrmProduct[]               @relation("CrmProductCreatedBy")
  crmProductsUpdated           CrmProduct[]               @relation("CrmProductUpdatedBy")
  crmOpportunitiesCreated      CrmOpportunity[]           @relation("CrmOpportunityCreatedBy")
  crmOpportunitiesUpdated      CrmOpportunity[]           @relation("CrmOpportunityUpdatedBy")
  crmOpportunitiesOwned        CrmOpportunity[]           @relation("CrmOpportunityOwner")
  crmLeadsCreated              CrmLead[]                  @relation("CrmLeadCreatedBy")
  crmLeadsUpdated              CrmLead[]                  @relation("CrmLeadUpdatedBy")
  crmLeadsOwned                CrmLead[]                  @relation("CrmLeadOwner")
  crmLeadRoutingRulesOwned     CrmLeadRoutingRule[]       @relation("CrmLeadRoutingOwner")
  crmCustomFieldsCreated       CrmCustomFieldDefinition[] @relation("CrmCustomFieldCreatedBy")
  crmCustomFieldsUpdated       CrmCustomFieldDefinition[] @relation("CrmCustomFieldUpdatedBy")
  crmTasksAssigned             CrmTask[]                  @relation("CrmTaskAssignee")
  crmTasksCreated              CrmTask[]                  @relation("CrmTaskCreatedBy")
  crmTasksUpdated              CrmTask[]                  @relation("CrmTaskUpdatedBy")
  crmNotesCreated              CrmNote[]                  @relation("CrmNoteCreatedBy")
  crmNotesUpdated              CrmNote[]                  @relation("CrmNoteUpdatedBy")
  crmActivitiesActed           CrmActivity[]              @relation("CrmActivityActor")
  crmQuotasOwned               CrmQuota[]                 @relation("CrmQuotaOwner")
  crmQuotasCreated             CrmQuota[]                 @relation("CrmQuotaCreatedBy")
  crmQuotasUpdated             CrmQuota[]                 @relation("CrmQuotaUpdatedBy")
  crmReportsCreated            CrmReport[]                @relation("CrmReportCreatedBy")
  crmReportsUpdated            CrmReport[]                @relation("CrmReportUpdatedBy")
  crmDashboardsCreated         CrmDashboard[]             @relation("CrmDashboardCreatedBy")
  crmDashboardsUpdated         CrmDashboard[]             @relation("CrmDashboardUpdatedBy")
  crmProposalsCreated          CrmProposal[]              @relation("CrmProposalCreatedBy")
  crmProposalsUpdated          CrmProposal[]              @relation("CrmProposalUpdatedBy")
  crmProposalsResponsible      CrmProposal[]              @relation("CrmProposalResponsible")
  crmProposalTemplatesCreated  CrmProposalTemplate[]      @relation("CrmProposalTemplateCreatedBy")
  crmProposalTemplatesUpdated  CrmProposalTemplate[]      @relation("CrmProposalTemplateUpdatedBy")
  crmFormsCreated              CrmForm[]                  @relation("CrmFormCreatedBy")
  crmFormsUpdated              CrmForm[]                  @relation("CrmFormUpdatedBy")
  crmAiConversationsOwned      CrmAiConversation[]        @relation("CrmAiConversationUser")
  crmIntegrationApiKeysCreated CrmIntegrationApiKey[]     @relation("CrmIntegrationApiKeyCreatedBy")
  crmEmailTemplatesCreated     CrmEmailTemplate[]         @relation("CrmEmailTemplateCreatedBy")
  crmEmailTemplatesUpdated     CrmEmailTemplate[]         @relation("CrmEmailTemplateUpdatedBy")
  crmEmailCampaignsCreated     CrmEmailCampaign[]         @relation("CrmEmailCampaignCreatedBy")
  crmMailingListsCreated       CrmMailingList[]           @relation("CrmMailingListCreatedBy")
  crmWorkflowsCreated          CrmWorkflow[]              @relation("CrmWorkflowCreatedBy")
  crmWorkflowsUpdated          CrmWorkflow[]              @relation("CrmWorkflowUpdatedBy")
  crmWorkflowRunsStarted       CrmWorkflowRun[]           @relation("CrmWorkflowRunStartedBy")
  crmLandingPagesCreated       CrmLandingPage[]           @relation("CrmLandingPageCreatedBy")
  crmLandingPagesUpdated       CrmLandingPage[]           @relation("CrmLandingPageUpdatedBy")
  crmSocialConnectionsCreated  CrmSocialConnection[]      @relation("CrmSocialConnectionCreatedBy")
  crmSocialConnectionsUpdated  CrmSocialConnection[]      @relation("CrmSocialConnectionUpdatedBy")
  crmHookVaultItemsCreated     CrmHookVaultItem[]         @relation("CrmHookVaultItemCreatedBy")
  crmHookVaultItemsUpdated     CrmHookVaultItem[]         @relation("CrmHookVaultItemUpdatedBy")
  crmTrackedCompetitorsCreated CrmTrackedCompetitor[]     @relation("CrmTrackedCompetitorCreatedBy")
  crmTrackedCompetitorsUpdated CrmTrackedCompetitor[]     @relation("CrmTrackedCompetitorUpdatedBy")
  crmScheduledPostsCreated     CrmScheduledPost[]         @relation("CrmScheduledPostCreatedBy")
  crmEmailAccounts             CrmEmailAccount[]          @relation("CrmEmailAccountUser")
  crmEmailMessagesCreated      CrmEmailMessage[]          @relation("CrmEmailMessageCreatedBy")
  crmCalendarEventsCreated     CrmCalendarEvent[]         @relation("CrmCalendarEventCreatedBy")

  @@index([deletionScheduledAt])
  @@map("users")
}

enum ConsentDocument {
  TERMS
  PRIVACY
  COOKIES
}

enum ConsentAction {
  GRANTED
  REVOKED
}

enum OnboardingStep {
  PROFILE
  ROLE
  BRINGS
  WORKSPACE
}

enum UserRole {
  PRODUCT_MANAGER
  ENGINEERING_MANAGER
  DESIGNER
  DEVELOPER
  FOUNDER_EXECUTIVE
  OPERATIONS_MANAGER
  OTHER
}

enum UserGoal {
  ROADMAP
  SPRINTS
  CROSS_FUNCTIONAL
  REPLACE_TOOL
  EXPLORING
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

enum QuickSendShortcut {
  ENTER
  CTRL_ENTER
}

model UserPreference {
  id                String            @id @default(cuid())
  userId            String            @unique @map("user_id")
  theme             Theme             @default(SYSTEM)
  smoothCursor      Boolean           @default(false) @map("smooth_cursor")
  quickSendShortcut QuickSendShortcut @default(ENTER) @map("quick_send_shortcut")
  timezone          String            @default("America/Sao_Paulo")
  weekStartsOn      Int               @default(1) @map("week_starts_on")
  weekendDays       Int[]             @default([0, 6]) @map("weekend_days")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationSetting {
  id              String   @id @default(cuid())
  userId          String   @unique @map("user_id")
  priorityChanges Boolean  @default(true) @map("priority_changes")
  stateChanges    Boolean  @default(true) @map("state_changes")
  comments        Boolean  @default(true)
  mentions        Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_setting")
}

model ConsentEvent {
  id        String          @id @default(cuid())
  userId    String          @map("user_id")
  document  ConsentDocument
  version   String
  action    ConsentAction
  ipAddress String?         @map("ip_address")
  userAgent String?         @map("user_agent")
  createdAt DateTime        @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, document, createdAt])
  @@map("consent_events")
}

model TwoFactor {
  id          String   @id @default(cuid())
  secret      String
  backupCodes String   @map("backup_codes")
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified    Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("two_factors")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime? @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")

  @@map("verifications")
}

model Workspace {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  activePlan    Plan           @default(FREE) @map("active_plan")
  trialEndsAt   DateTime?      @map("trial_ends_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  memberships   Membership[]
  subscriptions Subscription[]
  projects      Project[]
  backups       Backup[]

  invitations       WorkspaceInvitation[]
  moduleConnections WorkspaceModuleConnection[]
  moduleAccess      WorkspaceModuleAccess[]

  whatsappConnections          WhatsAppConnection[]
  whatsappContacts             WhatsAppContact[]
  whatsappConversations        WhatsAppConversation[]
  whatsappMessages             WhatsAppMessage[]
  whatsappQuickReplies         WhatsAppQuickReply[]
  whatsappBroadcastLists       WhatsAppBroadcastList[]
  whatsappTemplates            WhatsAppTemplate[]
  whatsappAiConfig             WhatsAppAiConfig?
  whatsappGroups               WhatsAppGroup[]
  whatsappGroupMessages        WhatsAppGroupMessage[]
  whatsappAiKnowledgeDocuments WhatsAppAiKnowledgeDocument[]

  crmCompanies              CrmCompany[]
  crmPeople                 CrmPerson[]
  crmPipelines              CrmPipeline[]
  crmProducts               CrmProduct[]
  crmOpportunities          CrmOpportunity[]
  crmLeads                  CrmLead[]
  crmLeadScoringRules       CrmLeadScoringRule[]
  crmLeadRoutingRules       CrmLeadRoutingRule[]
  crmCustomFieldDefinitions CrmCustomFieldDefinition[]
  crmTasks                  CrmTask[]
  crmNotes                  CrmNote[]
  crmActivities             CrmActivity[]
  crmQuotas                 CrmQuota[]
  crmReports                CrmReport[]
  crmDashboards             CrmDashboard[]
  crmProposals              CrmProposal[]
  crmProposalTemplates      CrmProposalTemplate[]
  crmForms                  CrmForm[]
  crmAiConversations        CrmAiConversation[]
  crmAiUsage                CrmAiUsage[]
  crmIntegrationApiKeys     CrmIntegrationApiKey[]
  crmEmailTemplates         CrmEmailTemplate[]
  crmEmailCampaigns         CrmEmailCampaign[]
  crmMailingLists           CrmMailingList[]
  crmWorkflows              CrmWorkflow[]
  crmLandingPages           CrmLandingPage[]
  crmSocialConnections      CrmSocialConnection[]
  crmScheduledPosts         CrmScheduledPost[]
  crmEmailAccounts          CrmEmailAccount[]
  crmEmailMessages          CrmEmailMessage[]
  crmCalendarEvents         CrmCalendarEvent[]
  crmHookVaultItems         CrmHookVaultItem[]
  crmTrackedCompetitors     CrmTrackedCompetitor[]

  profiles Profile[]

  @@map("workspaces")
}

model Membership {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  workspaceId String   @map("workspace_id")
  role        Role     @default(MEMBER)
  profileId   String?  @map("profile_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  profile   Profile?  @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@index([profileId])
  @@map("memberships")
}

/// Perfil de acesso (RBAC) — mapa recurso→ações. Perfis de sistema
/// (OWNER/ADMIN/MEMBER) são semeados por workspace (lazy) e preservam o
/// comportamento anterior aos perfis customizados.
model Profile {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  name        String
  isSystem    Boolean  @default(false) @map("is_system")
  systemKey   String?  @map("system_key")
  permissions Json
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  memberships Membership[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("profiles")
}

model Subscription {
  id          String             @id @default(cuid())
  billId      String             @unique @map("bill_id")
  plan        Plan
  status      SubscriptionStatus @default(PENDING)
  amount      Int
  seats       Int                @default(1)
  interval    BillingInterval    @default(MONTHLY)
  coupon      String?
  paymentUrl  String             @map("payment_url")
  workspaceId String             @map("workspace_id")
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@map("subscriptions")
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

model WorkspaceInvitation {
  id          String       @id @default(cuid())
  email       String
  role        Role         @default(MEMBER)
  token       String       @unique @default(cuid())
  status      InviteStatus @default(PENDING)
  expiresAt   DateTime     @map("expiresa_at")
  invitedById String       @map("invited_by_id")
  workspaceId String       @map("workspace_id")
  projectId   String?      @map("project_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inviter   User      @relation("SentInvitations", fields: [invitedById], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([email])
  @@map("workspace_invitations")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum Plan {
  FREE
  PRO
  BUSINESS
  ENTERPRISE
}

enum SubscriptionStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
  REFUNDED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum ComponentStatus {
  OPERATIONAL
  DEGRADED
  PARTIAL_OUTAGE
  MAJOR_OUTAGE
  MAINTENANCE
}

model HealthCheck {
  id           String          @id @default(cuid())
  componentKey String          @map("component_key")
  status       ComponentStatus
  latencyMs    Int             @map("latency_ms")
  error        String?
  checkedAt    DateTime        @default(now()) @map("checked_at")

  @@index([componentKey, checkedAt])
  @@index([checkedAt])
  @@map("health_checks")
}

model ComponentDaily {
  id           String          @id @default(cuid())
  componentKey String          @map("component_key")
  day          DateTime        @db.Date
  worstStatus  ComponentStatus @map("worst_status")
  totalChecks  Int             @map("total_checks")
  upChecks     Int             @map("up_checks")
  uptimePct    Decimal         @map("uptime_pct") @db.Decimal(6, 3)
  avgLatencyMs Int             @map("avg_latency_ms")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  @@unique([componentKey, day])
  @@index([componentKey, day])
  @@map("component_dailies")
}

enum IncidentEvent {
  INVESTIGATING
  IDENTIFIED
  MONITORING
  RESOLVED
}

model Incident {
  id           String           @id @default(cuid())
  componentKey String           @map("component_key")
  severity     ComponentStatus
  title        String
  startedAt    DateTime         @map("started_at")
  resolvedAt   DateTime?        @map("resolved_at")
  updates      IncidentUpdate[]

  @@index([componentKey, startedAt])
  @@index([resolvedAt])
  @@index([startedAt])
  @@map("incidents")
}

model IncidentUpdate {
  id         String        @id @default(cuid())
  incidentId String        @map("incident_id")
  event      IncidentEvent
  message    String
  postedAt   DateTime      @default(now()) @map("posted_at")
  incident   Incident      @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, postedAt])
  @@map("incident_updates")
}

model ShortLink {
  id        String   @id @default(cuid())
  title     String   @map("title")
  url       String   @map("url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @map("user_id")

  @@index([createdAt])
  @@map("short_links")
}

enum StickyColor {
  RED
  YELLOW
  BLUE
  GREEN
  PURPLE
  ZINC
}

model StickyNote {
  id        String      @id @default(cuid())
  content   Json        @map("content")
  color     StickyColor @default(ZINC) @map("color")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @map("user_id")

  @@index([userId, updatedAt])
  @@map("sticky_notes")
}

model Project {
  id          String    @id @default(cuid())
  name        String
  slug        String
  description String?
  emoji       String?
  coverImage  String?   @map("cover_image")
  isPublic    Boolean   @default(false) @map("is_public")
  leadId      String    @map("lead_id")
  workspaceId String    @map("workspace_id")
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  lead        User                  @relation("ProjectLead", fields: [leadId], references: [id])
  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members     ProjectMember[]
  favourites  ProjectFavorite[]
  invitations WorkspaceInvitation[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, archivedAt])
  @@index([leadId])
  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  projectId String   @map("project_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

model ProjectFavorite {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  projectId String   @map("project_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
  @@map("project_favorites")
}

enum ModuleKind {
  SERVICE_DESK
  CRM
  COMMUNICATION
}

model WorkspaceModuleConnection {
  id                String     @id @default(cuid())
  workspaceId       String     @map("workspace_id")
  module            ModuleKind
  host              String
  port              Int
  username          String
  encryptedPassword String     @map("encrypted_password")
  database          String
  sslEnabled        Boolean    @default(true) @map("ssl_enabled")
  createdById       String     @map("created_by_id")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([workspaceId, module])
  @@index([workspaceId])
  @@map("workspace_module_connections")
}

/// Entitlement de módulo por workspace, controlado pelo painel admin
/// global. Sem registro para um módulo, ele fica indisponível — é opt-in,
/// não opt-out (evita expor CRM/WhatsApp/ServiceDesk por omissão).
model WorkspaceModuleAccess {
  id          String     @id @default(cuid())
  workspaceId String     @map("workspace_id")
  module      ModuleKind
  enabled     Boolean    @default(true)
  grantedById String     @map("granted_by_id")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  grantedBy User      @relation(fields: [grantedById], references: [id], onDelete: Cascade)

  @@unique([workspaceId, module])
  @@index([workspaceId])
  @@map("workspace_module_access")
}

// ─── Backups ────────────────────────────────────────────────────────────────

enum BackupScope {
  FULL
  WORKSPACE

  @@map("backup_scope")
}

enum BackupStatus {
  RUNNING
  COMPLETED
  FAILED

  @@map("backup_status")
}

model Backup {
  id           String       @id @default(cuid())
  scope        BackupScope
  workspaceId  String?      @map("workspace_id")
  status       BackupStatus @default(RUNNING)
  storageKey   String?      @map("storage_key")
  sizeBytes    Int?         @map("size_bytes")
  checksum     String?
  errorMessage String?      @map("error_message")
  startedAt    DateTime     @default(now()) @map("started_at")
  completedAt  DateTime?    @map("completed_at")
  expiresAt    DateTime?    @map("expires_at")

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([scope, startedAt])
  @@index([workspaceId])
  @@index([expiresAt])
  @@map("backups")
}

// ─── WhatsApp domain ───────────────────────────────────────────────────────

enum WhatsAppProvider {
  ZAPI
  META
}

enum WhatsAppConnectionStatus {
  CONNECTING
  CONNECTED
  DISCONNECTED
  ERROR
}

model WhatsAppConnection {
  id                       String                   @id @default(cuid())
  workspaceId              String                   @map("workspace_id")
  provider                 WhatsAppProvider
  label                    String
  phoneNumber              String                   @map("phone_number")
  status                   WhatsAppConnectionStatus @default(CONNECTING)
  statusError              String?                  @map("status_error")
  webhookSecret            String                   @unique @default(cuid()) @map("webhook_secret")
  zapiInstanceId           String?                  @map("zapi_instance_id")
  encryptedZapiToken       String?                  @map("encrypted_zapi_token")
  encryptedZapiClientToken String?                  @map("encrypted_zapi_client_token")
  metaPhoneNumberId        String?                  @map("meta_phone_number_id")
  metaWabaId               String?                  @map("meta_waba_id")
  encryptedMetaAccessToken String?                  @map("encrypted_meta_access_token")
  createdById              String                   @map("created_by_id")
  createdAt                DateTime                 @default(now()) @map("created_at")
  updatedAt                DateTime                 @updatedAt @map("updated_at")

  workspace      Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy      User                    @relation("WhatsAppConnectionCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  conversations  WhatsAppConversation[]
  broadcastLists WhatsAppBroadcastList[]
  templates      WhatsAppTemplate[]
  groups         WhatsAppGroup[]

  @@unique([workspaceId, provider, phoneNumber])
  @@index([workspaceId])
  @@index([zapiInstanceId])
  @@index([metaPhoneNumberId])
  @@map("whatsapp_connections")
}

model WhatsAppContact {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  waId        String   @map("wa_id")
  name        String?
  avatarUrl   String?  @map("avatar_url")
  // Freeform "about"/bio text — manually entered, no provider API exposes this.
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace           Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations       WhatsAppConversation[]
  broadcastRecipients WhatsAppBroadcastRecipient[]

  @@unique([workspaceId, waId])
  @@index([workspaceId])
  @@map("whatsapp_contacts")
}

enum WhatsAppConversationStatus {
  NEW
  IN_PROGRESS
  CLOSED
}

model WhatsAppConversation {
  id                String                     @id @default(cuid())
  workspaceId       String                     @map("workspace_id")
  connectionId      String                     @map("connection_id")
  contactId         String                     @map("contact_id")
  status            WhatsAppConversationStatus @default(NEW)
  assignedUserId    String?                    @map("assigned_user_id")
  aiActive          Boolean                    @default(false) @map("ai_active")
  aiHandoff         Boolean                    @default(false) @map("ai_handoff")
  unreadCount       Int                        @default(0) @map("unread_count")
  /// Média das últimas mensagens classificadas (IN) da conversa, de -1
  /// (negativo) a 1 (positivo). Nulo até a primeira classificação.
  avgSentimentScore Float?                     @map("avg_sentiment_score")
  lastMessageAt     DateTime?                  @map("last_message_at")
  pinnedAt          DateTime?                  @map("pinned_at")
  archivedAt        DateTime?                  @map("archived_at")
  deletedAt         DateTime?                  @map("deleted_at")
  clearedAt         DateTime?                  @map("cleared_at")
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @updatedAt @map("updated_at")

  workspace    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection   WhatsAppConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  contact      WhatsAppContact    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedUser User?              @relation("WhatsAppConversationAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  messages     WhatsAppMessage[]

  @@index([workspaceId, status, lastMessageAt])
  @@index([workspaceId, deletedAt, archivedAt, pinnedAt])
  @@index([connectionId])
  @@index([contactId])
  @@index([assignedUserId])
  @@map("whatsapp_conversations")
}

enum WhatsAppMessageDirection {
  IN
  OUT
}

enum WhatsAppMessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  STICKER
  LOCATION
  TEMPLATE
  BUTTON
  CONTACT
}

enum WhatsAppMessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum WhatsAppSentiment {
  NEGATIVE
  NEUTRAL
  POSITIVE
}

model WhatsAppMessage {
  id                String                   @id @default(cuid())
  workspaceId       String                   @map("workspace_id")
  conversationId    String                   @map("conversation_id")
  direction         WhatsAppMessageDirection
  type              WhatsAppMessageType
  text              String?
  mediaUrl          String?                  @map("media_url")
  providerMessageId String?                  @unique @map("provider_message_id")
  status            WhatsAppMessageStatus    @default(PENDING)
  senderUserId      String?                  @map("sender_user_id")
  sentByAi          Boolean                  @default(false) @map("sent_by_ai")
  replyToMessageId  String?                  @map("reply_to_message_id")
  reactionEmoji     String?                  @map("reaction_emoji")
  // Who set reactionEmoji: true = the contact reacted, false = an agent
  // reacted. Meaningless while reactionEmoji is null.
  reactedByContact  Boolean?                 @map("reacted_by_contact")
  contactPayload    Json?                    @map("contact_payload")
  /// Classificação de humor — só preenchido em mensagens recebidas (IN),
  /// pelo job de análise de sentimento (não bloqueia o envio/recebimento).
  sentiment         WhatsAppSentiment?
  sentimentScore    Float?                   @map("sentiment_score")
  deletedAt         DateTime?                @map("deleted_at")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")

  workspace      Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation   WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUser     User?                @relation("WhatsAppMessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)
  replyToMessage WhatsAppMessage?     @relation("WhatsAppMessageReply", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies        WhatsAppMessage[]    @relation("WhatsAppMessageReply")

  @@index([workspaceId])
  @@index([conversationId, createdAt])
  @@index([replyToMessageId])
  @@map("whatsapp_messages")
}

model WhatsAppQuickReply {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  shortcut    String
  title       String
  body        String
  mediaUrl    String?  @map("media_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, shortcut])
  @@index([workspaceId])
  @@map("whatsapp_quick_replies")
}

enum WhatsAppBroadcastStatus {
  DRAFT
  QUEUED
  RUNNING
  DONE
  FAILED
}

model WhatsAppBroadcastList {
  id           String                  @id @default(cuid())
  workspaceId  String                  @map("workspace_id")
  connectionId String                  @map("connection_id")
  templateId   String?                 @map("template_id")
  name         String
  messageBody  String                  @map("message_body")
  mediaUrl     String?                 @map("media_url")
  status       WhatsAppBroadcastStatus @default(DRAFT)
  scheduledAt  DateTime?               @map("scheduled_at")
  createdById  String                  @map("created_by_id")
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")

  workspace  Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection WhatsAppConnection           @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  template   WhatsAppTemplate?            @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdBy  User                         @relation("WhatsAppBroadcastCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  recipients WhatsAppBroadcastRecipient[]

  @@index([workspaceId])
  @@index([templateId])
  @@map("whatsapp_broadcast_lists")
}

enum WhatsAppBroadcastRecipientStatus {
  PENDING
  SENT
  FAILED
}

model WhatsAppBroadcastRecipient {
  id                String                           @id @default(cuid())
  broadcastListId   String                           @map("broadcast_list_id")
  contactId         String                           @map("contact_id")
  status            WhatsAppBroadcastRecipientStatus @default(PENDING)
  // Valores para preencher as variáveis do template Meta, na forma
  // TemplateFillValues (header/body/buttons) de template-variables.ts.
  // Nulo para broadcasts de texto simples (sem template).
  variableValues    Json?                            @map("variable_values")
  // Horário de disparo individual — cada linha da planilha importada tem
  // sua própria data de referência (ex: consulta agendada), então o
  // agendamento é por destinatário, não pela lista inteira.
  scheduledAt       DateTime?                        @map("scheduled_at")
  // Data/hora real do compromisso (ex: exame), distinta de `scheduledAt`
  // (horário de disparo do lembrete = appointmentAt - sendOffsetHours).
  // Consultada pela IA via tool calling quando o cliente pergunta sobre
  // agendamentos.
  appointmentAt     DateTime?                        @map("appointment_at")
  providerMessageId String?                          @map("provider_message_id")
  errorMessage      String?                          @map("error_message")
  sentAt            DateTime?                        @map("sent_at")
  createdAt         DateTime                         @default(now()) @map("created_at")

  broadcastList WhatsAppBroadcastList @relation(fields: [broadcastListId], references: [id], onDelete: Cascade)
  contact       WhatsAppContact       @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([broadcastListId, contactId])
  @@index([broadcastListId, status])
  @@index([status, scheduledAt])
  @@index([contactId, appointmentAt])
  @@map("whatsapp_broadcast_recipients")
}

enum WhatsAppTemplateStatus {
  APPROVED
  PENDING
  REJECTED
}

model WhatsAppTemplate {
  id           String                 @id @default(cuid())
  workspaceId  String                 @map("workspace_id")
  connectionId String                 @map("connection_id")
  name         String
  language     String
  category     String
  status       WhatsAppTemplateStatus @default(PENDING)
  components   Json
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")

  workspace      Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection     WhatsAppConnection      @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  broadcastLists WhatsAppBroadcastList[]

  @@unique([connectionId, name, language])
  @@index([workspaceId])
  @@map("whatsapp_templates")
}

model WhatsAppAiConfig {
  id                    String   @id @default(cuid())
  workspaceId           String   @unique @map("workspace_id")
  encryptedOpenaiApiKey String   @map("encrypted_openai_api_key")
  model                 String   @default("gpt-4o-mini")
  systemPrompt          String   @map("system_prompt")
  active                Boolean  @default(false)
  // Opt-in: lets the AI look at received images (Vision) and transcribe
  // received audio (Whisper) instead of a static "[imagem]"/"[áudio]"
  // placeholder. Off by default — extra OpenAI cost/latency per media message.
  readMedia             Boolean  @default(false) @map("read_media")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("whatsapp_ai_configs")
}

enum WhatsAppAiKnowledgeDocumentStatus {
  PROCESSING
  READY
  FAILED
}

/// Base de conhecimento da IA do WhatsApp. O arquivo original fica no MinIO
/// (storageKey); o texto extraído é injetado direto no systemPrompt do
/// processor de resposta (sem embeddings/busca — poucos documentos por
/// workspace no caso de uso real, não uma base grande).
model WhatsAppAiKnowledgeDocument {
  id            String                            @id @default(cuid())
  workspaceId   String                            @map("workspace_id")
  filename      String
  contentType   String                            @map("content_type")
  sizeBytes     Int                               @map("size_bytes")
  storageKey    String                            @map("storage_key")
  status        WhatsAppAiKnowledgeDocumentStatus @default(PROCESSING)
  extractedText String?                           @map("extracted_text")
  errorMessage  String?                           @map("error_message")
  createdById   String                            @map("created_by_id")
  createdAt     DateTime                          @default(now()) @map("created_at")
  updatedAt     DateTime                          @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("WhatsAppAiKnowledgeDocumentCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@map("whatsapp_ai_knowledge_documents")
}

// ─── WhatsApp groups (Z-API only — the Meta Cloud API has no group endpoints) ──

enum WhatsAppGroupParticipantRole {
  MEMBER
  ADMIN
}

model WhatsAppGroup {
  id            String    @id @default(cuid())
  workspaceId   String    @map("workspace_id")
  connectionId  String    @map("connection_id")
  groupJid      String    @map("group_jid")
  name          String
  imageUrl      String?   @map("image_url")
  description   String?
  inviteLink    String?   @map("invite_link")
  lastMessageAt DateTime? @map("last_message_at")
  archivedAt    DateTime? @map("archived_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  workspace    Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection   WhatsAppConnection         @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  participants WhatsAppGroupParticipant[]
  messages     WhatsAppGroupMessage[]

  @@unique([workspaceId, groupJid])
  @@index([workspaceId, archivedAt, lastMessageAt])
  @@index([connectionId])
  @@map("whatsapp_groups")
}

model WhatsAppGroupParticipant {
  id        String                       @id @default(cuid())
  groupId   String                       @map("group_id")
  waId      String                       @map("wa_id")
  name      String?
  role      WhatsAppGroupParticipantRole @default(MEMBER)
  createdAt DateTime                     @default(now()) @map("created_at")

  group WhatsAppGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, waId])
  @@index([groupId])
  @@map("whatsapp_group_participants")
}

enum WhatsAppGroupMessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

model WhatsAppGroupMessage {
  id                String                     @id @default(cuid())
  workspaceId       String                     @map("workspace_id")
  groupId           String                     @map("group_id")
  direction         WhatsAppMessageDirection
  type              WhatsAppMessageType
  text              String?
  mediaUrl          String?                    @map("media_url")
  providerMessageId String?                    @unique @map("provider_message_id")
  status            WhatsAppGroupMessageStatus @default(PENDING)
  senderUserId      String?                    @map("sender_user_id")
  // Inbound only: which participant actually sent it, since group messages
  // arrive addressed to the group JID, not an individual contact.
  senderWaId        String?                    @map("sender_wa_id")
  senderName        String?                    @map("sender_name")
  deletedAt         DateTime?                  @map("deleted_at")
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @updatedAt @map("updated_at")

  workspace  Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  group      WhatsAppGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  senderUser User?         @relation("WhatsAppGroupMessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([groupId, createdAt])
  @@map("whatsapp_group_messages")
}

// ─── CRM domain ─────────────────────────────────────────────────────────────

/// Empresa/conta do CRM, escopada por workspace.
model CrmCompany {
  id             String    @id @default(cuid())
  name           String    @default("")
  cnpj           String?
  domain         String?
  employees      Int?
  linkedin       String?
  address        Json?
  arr            Decimal?  @db.Decimal(14, 2)
  icp            Boolean   @default(false)
  workspaceId    String    @map("workspace_id")
  createdById    String    @map("created_by_id")
  accountOwnerId String?   @map("account_owner_id")
  updatedById    String?   @map("updated_by_id")
  position       Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy    User      @relation("CrmCompanyCreatedBy", fields: [createdById], references: [id])
  accountOwner User?     @relation("CrmCompanyAccountOwner", fields: [accountOwnerId], references: [id])
  updatedBy    User?     @relation("CrmCompanyUpdatedBy", fields: [updatedById], references: [id])

  people        CrmPerson[]
  opportunities CrmOpportunity[]
  tasks         CrmTask[]
  notes         CrmNote[]
  proposals     CrmProposal[]

  @@unique([workspaceId, domain])
  @@unique([workspaceId, cnpj])
  @@index([workspaceId])
  @@index([accountOwnerId])
  @@index([deletedAt])
  @@index([workspaceId, position])
  @@map("crm_companies")
}

/// Pessoa/contato do CRM, escopada por workspace e opcionalmente ligada a uma CrmCompany.
model CrmPerson {
  id          String    @id @default(cuid())
  name        String
  emails      String[]  @default([])
  phones      String[]  @default([])
  city        String?
  jobTitle    String?   @map("job_title")
  linkedin    String?
  avatar      String?
  companyId   String?   @map("company_id")
  workspaceId String    @map("workspace_id")
  createdById String    @map("created_by_id")
  updatedById String?   @map("updated_by_id")
  position    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company   CrmCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdBy User        @relation("CrmPersonCreatedBy", fields: [createdById], references: [id])
  updatedBy User?       @relation("CrmPersonUpdatedBy", fields: [updatedById], references: [id])

  opportunitiesAsPointOfContact CrmOpportunity[]   @relation("CrmOpportunityPointOfContact")
  convertedFromLeads            CrmLead[]
  tasks                         CrmTask[]
  notes                         CrmNote[]
  emailMessages                 CrmEmailMessage[]
  calendarEvents                CrmCalendarEvent[]
  proposalsAsContact            CrmProposal[]      @relation("CrmProposalContact")

  @@index([workspaceId])
  @@index([companyId])
  @@index([deletedAt])
  @@index([workspaceId, position])
  @@map("crm_people")
}

enum CrmBillingType {
  ONE_TIME
  MONTHLY
  YEARLY
}

enum CrmStageCategory {
  OPEN
  WON
  LOST
}

/// Funil de vendas configurável por workspace.
model CrmPipeline {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  name        String
  position    Int       @default(0)
  isDefault   Boolean   @default(false) @map("is_default")
  createdById String    @map("created_by_id")
  updatedById String?   @map("updated_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("CrmPipelineCreatedBy", fields: [createdById], references: [id])
  updatedBy User?     @relation("CrmPipelineUpdatedBy", fields: [updatedById], references: [id])

  stages        CrmPipelineStage[]
  opportunities CrmOpportunity[]

  @@index([workspaceId])
  @@index([workspaceId, position])
  @@index([deletedAt])
  @@map("crm_pipelines")
}

/// Etapa de um pipeline. `probability` (0-100) e `category` alimentam o forecast.
model CrmPipelineStage {
  id          String           @id @default(cuid())
  pipelineId  String           @map("pipeline_id")
  name        String
  position    Int              @default(0)
  probability Int              @default(0)
  category    CrmStageCategory @default(OPEN)
  color       String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  pipeline      CrmPipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  opportunities CrmOpportunity[]

  @@index([pipelineId])
  @@index([pipelineId, position])
  @@map("crm_pipeline_stages")
}

/// Produto/serviço do catálogo da workspace.
model CrmProduct {
  id          String         @id @default(cuid())
  workspaceId String         @map("workspace_id")
  name        String
  sku         String?
  description String?
  unitPrice   Decimal        @default(0) @map("unit_price") @db.Decimal(14, 2)
  currency    String         @default("BRL")
  billingType CrmBillingType @default(ONE_TIME) @map("billing_type")
  active      Boolean        @default(true)
  position    Int            @default(0)
  createdById String         @map("created_by_id")
  updatedById String?        @map("updated_by_id")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  deletedAt   DateTime?      @map("deleted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("CrmProductCreatedBy", fields: [createdById], references: [id])
  updatedBy User?     @relation("CrmProductUpdatedBy", fields: [updatedById], references: [id])

  lineItems CrmOpportunityLineItem[]

  @@unique([workspaceId, sku])
  @@index([workspaceId])
  @@index([workspaceId, position])
  @@index([deletedAt])
  @@map("crm_products")
}

/// Oportunidade de venda vinculada a um pipeline/etapa.
model CrmOpportunity {
  id               String    @id @default(cuid())
  name             String
  amount           Decimal?  @db.Decimal(14, 2)
  /// Override de probabilidade (0-100) por negócio; quando nulo, o forecast
  /// usa o padrão da etapa (CrmPipelineStage.probability).
  probability      Int?
  closeDate        DateTime? @map("close_date")
  pipelineId       String    @map("pipeline_id")
  stageId          String    @map("stage_id")
  companyId        String?   @map("company_id")
  pointOfContactId String?   @map("point_of_contact_id")
  ownerId          String?   @map("owner_id")
  source           String?
  workspaceId      String    @map("workspace_id")
  createdById      String    @map("created_by_id")
  updatedById      String?   @map("updated_by_id")
  position         Int       @default(0)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pipeline       CrmPipeline      @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  stage          CrmPipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)
  company        CrmCompany?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  pointOfContact CrmPerson?       @relation("CrmOpportunityPointOfContact", fields: [pointOfContactId], references: [id], onDelete: SetNull)
  owner          User?            @relation("CrmOpportunityOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy      User             @relation("CrmOpportunityCreatedBy", fields: [createdById], references: [id])
  updatedBy      User?            @relation("CrmOpportunityUpdatedBy", fields: [updatedById], references: [id])

  lineItems      CrmOpportunityLineItem[]
  tasks          CrmTask[]
  notes          CrmNote[]
  emailMessages  CrmEmailMessage[]
  calendarEvents CrmCalendarEvent[]
