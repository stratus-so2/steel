enum CrmSocialPlatform {
  FACEBOOK
  INSTAGRAM
  TIKTOK
  YOUTUBE
  GOOGLE_ANALYTICS
  TWITTER
  GOOGLE_ADS
  LINKEDIN
}

enum CrmSocialConnectionStatus {
  CONNECTED
  EXPIRED
  REVOKED
}

/// Registro de uma conta social vinculada ao workspace via OAuth real
/// (Fase 13). Tokens ficam cifrados em repouso (AES-256-GCM, ver
/// src/lib/social/crypto.ts) — nunca expostos em DTO. `externalAccountId`/
/// `accountName` continuam preenchíveis manualmente para o fluxo legado
/// (conta já autorizada fora do Steel), mas o fluxo principal agora é o
/// handshake OAuth completo por plataforma.
model CrmSocialConnection {
  id                String                    @id @default(cuid())
  platform          CrmSocialPlatform
  externalAccountId String                    @map("external_account_id")
  accountName       String?                   @map("account_name")
  accessToken       String?                   @map("access_token")
  refreshToken      String?                   @map("refresh_token")
  tokenExpiresAt    DateTime?                 @map("token_expires_at")
  scope             String?
  isPrimary         Boolean                   @default(false) @map("is_primary")
  status            CrmSocialConnectionStatus @default(CONNECTED)
  workspaceId       String                    @map("workspace_id")
  createdById       String                    @map("created_by_id")
  updatedById       String?                   @map("updated_by_id")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  workspace       Workspace                           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy       User                                @relation("CrmSocialConnectionCreatedBy", fields: [createdById], references: [id])
  updatedBy       User?                               @relation("CrmSocialConnectionUpdatedBy", fields: [updatedById], references: [id])
  metricSnapshots CrmSocialConnectionMetricSnapshot[]

  @@unique([workspaceId, platform, externalAccountId])
  @@index([workspaceId, platform])
  @@map("crm_social_connections")
}

/// Snapshot diário de métricas da própria conta conectada — contraparte de
/// `CrmCompetitorMetricSnapshot`, necessário para comparar "nós vs.
/// concorrente" na mesma escala de tempo. Gravado pelo mesmo job
/// `CrmCompetitorSync`.
model CrmSocialConnectionMetricSnapshot {
  id             String   @id @default(cuid())
  connectionId   String   @map("connection_id")
  followersCount Int      @map("followers_count")
  postsCount     Int?     @map("posts_count")
  capturedAt     DateTime @default(now()) @map("captured_at")

  connection CrmSocialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, capturedAt])
  @@map("crm_social_connection_metric_snapshots")
}

/// Biblioteca reordenável de "hooks" (linhas de abertura/copy reaproveitável
/// para posts sociais).
model CrmHookVaultItem {
  id          String             @id @default(cuid())
  text        String
  platform    CrmSocialPlatform?
  usageCount  Int                @default(0) @map("usage_count")
  notes       String?
  workspaceId String             @map("workspace_id")
  createdById String             @map("created_by_id")
  updatedById String?            @map("updated_by_id")
  position    Int                @default(0)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  deletedAt   DateTime?          @map("deleted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("CrmHookVaultItemCreatedBy", fields: [createdById], references: [id])
  updatedBy User?     @relation("CrmHookVaultItemUpdatedBy", fields: [updatedById], references: [id])

  @@index([workspaceId])
  @@index([deletedAt])
  @@index([workspaceId, position])
  @@map("crm_hook_vault_items")
}

/// Status de sincronização automática de métricas de um concorrente.
/// `MANUAL`: cadastrado à mão, sem sync (plataforma não suportada ou nunca
/// sincronizado). `SYNCED`: último sync OK. `SYNC_FAILED`: última tentativa
/// falhou (perfil privado/inexistente ou sem conta conectada na plataforma).
enum CrmCompetitorSyncStatus {
  MANUAL
  SYNCED
  SYNC_FAILED
}

/// Perfil social de um concorrente rastreado. Pode ser cadastrado manualmente
/// ou via autofill (Instagram/YouTube), e sincronizado diariamente pelo job
/// `CrmCompetitorSync` — ver `CrmCompetitorMetricSnapshot` para o histórico.
model CrmTrackedCompetitor {
  id             String                  @id @default(cuid())
  platform       CrmSocialPlatform
  handle         String
  profileUrl     String?                 @map("profile_url")
  followersCount Int?                    @map("followers_count")
  avatarUrl      String?                 @map("avatar_url")
  displayName    String?                 @map("display_name")
  bio            String?
  syncStatus     CrmCompetitorSyncStatus @default(MANUAL) @map("sync_status")
  lastSyncedAt   DateTime?               @map("last_synced_at")
  notes          String?
  workspaceId    String                  @map("workspace_id")
  createdById    String                  @map("created_by_id")
  updatedById    String?                 @map("updated_by_id")
  position       Int                     @default(0)
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")
  deletedAt      DateTime?               @map("deleted_at")

  workspace       Workspace                      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy       User                           @relation("CrmTrackedCompetitorCreatedBy", fields: [createdById], references: [id])
  updatedBy       User?                          @relation("CrmTrackedCompetitorUpdatedBy", fields: [updatedById], references: [id])
  metricSnapshots CrmCompetitorMetricSnapshot[]

  @@index([workspaceId])
  @@index([deletedAt])
  @@index([workspaceId, position])
  @@map("crm_tracked_competitors")
}

/// Snapshot diário de métricas públicas de um concorrente (série histórica
/// usada para calcular taxa de crescimento e variação de seguidores).
/// Gravado pelo job `CrmCompetitorSync`; sem `createdBy` porque é
/// system-generated, não uma ação de usuário.
model CrmCompetitorMetricSnapshot {
  id             String   @id @default(cuid())
  competitorId   String   @map("competitor_id")
  followersCount Int      @map("followers_count")
  postsCount     Int?     @map("posts_count")
  capturedAt     DateTime @default(now()) @map("captured_at")

  competitor CrmTrackedCompetitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@index([competitorId, capturedAt])
  @@map("crm_competitor_metric_snapshots")
}

/// PARTIALLY_FAILED = ao menos um alvo publicou e ao menos um falhou (vide
/// CrmScheduledPostTarget para o detalhe). DRAFT é reservado para posts
/// legados criados sem `scheduledFor`.
enum CrmScheduledPostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  PARTIALLY_FAILED
  FAILED
  CANCELED
}

enum CrmScheduledPostTargetStatus {
  PENDING
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELED
}

/// Tipo de mídia anexada a um CrmScheduledPost — determina para quais
/// plataformas o post é elegível (ex.: VIDEO habilita YouTube/TikTok).
enum CrmScheduledMediaKind {
  IMAGE
  VIDEO
}

model CrmScheduledPost {
  id           String                 @id @default(cuid())
  content      String                 @default("") @db.Text
  title        String?
  options      Json?
  status       CrmScheduledPostStatus @default(DRAFT)
  scheduledFor DateTime?              @map("scheduled_for")
  publishedAt  DateTime?              @map("published_at")
  lastError    String?                @map("last_error")
  workspaceId  String                 @map("workspace_id")
  createdById  String                 @map("created_by_id")
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")
  deletedAt    DateTime?              @map("deleted_at")

  workspace Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User                      @relation("CrmScheduledPostCreatedBy", fields: [createdById], references: [id])
  targets   CrmScheduledPostTarget[]
  media     CrmScheduledPostMedia[]

  @@index([workspaceId])
  @@index([status, scheduledFor])
  @@index([deletedAt])
  @@map("crm_scheduled_posts")
}

/// `error` explica por que o alvo não foi publicado. `externalPostId` guarda
/// o id retornado pela rede após publicar; `attempts` conta tentativas do
/// cron/publish manual (idempotência/observabilidade).
model CrmScheduledPostTarget {
  id             String                       @id @default(cuid())
  postId         String                       @map("post_id")
  platform       CrmSocialPlatform
  status         CrmScheduledPostTargetStatus @default(PENDING)
  externalPostId String?                      @map("external_post_id")
  error          String?
  attempts       Int                          @default(0)
  publishedAt    DateTime?                    @map("published_at")
  createdAt      DateTime                     @default(now()) @map("created_at")
  updatedAt      DateTime                     @updatedAt @map("updated_at")

  post CrmScheduledPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, platform])
  @@index([postId])
  @@map("crm_scheduled_post_targets")
}

/// Mídia anexada a um CrmScheduledPost. Os bytes vivem no MinIO sob
/// `storageKey`; aqui só os metadados. `order` mantém a sequência.
model CrmScheduledPostMedia {
  id          String                @id @default(cuid())
  postId      String                @map("post_id")
  kind        CrmScheduledMediaKind
  storageKey  String                @map("storage_key")
  contentType String                @map("content_type")
  sizeBytes   Int                   @map("size_bytes")
  order       Int                   @default(0)
  createdAt   DateTime              @default(now()) @map("created_at")

  post CrmScheduledPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("crm_scheduled_post_media")
}

enum CrmEmailProvider {
  GMAIL
  OUTLOOK
}

enum CrmMailDirection {
  INBOUND
  OUTBOUND
}

/// Registro de conta de e-mail vinculada a um usuário do workspace. Este
/// módulo NÃO implementa o sync real contra Gmail/Outlook (exige client
/// OAuth por provedor, não fornecido) — `lastSyncedAt` permanece null;
/// CrmEmailMessage/CrmCalendarEvent são preenchidos manualmente pelo usuário
/// como registro de atividade, não por importação automática.
model CrmEmailAccount {
  id           String           @id @default(cuid())
  workspaceId  String           @map("workspace_id")
  userId       String           @map("user_id")
  provider     CrmEmailProvider
  email        String
  lastSyncedAt DateTime?        @map("last_synced_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User               @relation("CrmEmailAccountUser", fields: [userId], references: [id], onDelete: Cascade)
  messages  CrmEmailMessage[]
  events    CrmCalendarEvent[]

  @@unique([workspaceId, userId, provider])
  @@index([workspaceId])
  @@map("crm_email_accounts")
}

/// E-mail registrado manualmente (não sincronizado), vinculado a um contato
/// e/ou oportunidade para dar contexto de histórico de comunicação.
model CrmEmailMessage {
  id            String           @id @default(cuid())
  workspaceId   String           @map("workspace_id")
  accountId     String?          @map("account_id")
  createdById   String           @map("created_by_id")
  direction     CrmMailDirection
  subject       String?
  snippet       String?          @db.Text
  fromEmail     String           @map("from_email")
  toEmails      String[]         @default([]) @map("to_emails")
  personId      String?          @map("person_id")
  opportunityId String?          @map("opportunity_id")
  sentAt        DateTime         @map("sent_at")
  createdAt     DateTime         @default(now()) @map("created_at")

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account     CrmEmailAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdBy   User             @relation("CrmEmailMessageCreatedBy", fields: [createdById], references: [id])
  person      CrmPerson?       @relation(fields: [personId], references: [id], onDelete: SetNull)
  opportunity CrmOpportunity?  @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([personId, sentAt])
  @@index([opportunityId, sentAt])
  @@map("crm_email_messages")
}

/// Evento de agenda registrado manualmente, vinculado a um contato e/ou
/// oportunidade.
model CrmCalendarEvent {
  id            String   @id @default(cuid())
  workspaceId   String   @map("workspace_id")
  accountId     String?  @map("account_id")
  createdById   String   @map("created_by_id")
  title         String
  description   String?
  startsAt      DateTime @map("starts_at")
  endsAt        DateTime @map("ends_at")
  attendees     String[] @default([])
  personId      String?  @map("person_id")
  opportunityId String?  @map("opportunity_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account     CrmEmailAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdBy   User             @relation("CrmCalendarEventCreatedBy", fields: [createdById], references: [id])
  person      CrmPerson?       @relation(fields: [personId], references: [id], onDelete: SetNull)
  opportunity CrmOpportunity?  @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([personId, startsAt])
  @@index([opportunityId, startsAt])
  @@map("crm_calendar_events")
}

// ─── Changelog (admin, cross-workspace) ───────────────────────────────────

enum ChangelogStatus {
  DRAFT
  QUEUED
  RUNNING
  DONE
  FAILED
}

enum ChangelogRecipientStatus {
  PENDING
  SENT
  FAILED
}

/// E-mail de novidades disparado pelo admin global da plataforma (não é
/// por workspace) — cobre tanto avisos jurídicos (ex: mudança nos Termos)
/// quanto changelog de produto, através de uma lista de itens livre.
model Changelog {
  id          String          @id @default(cuid())
  subject     String
  status      ChangelogStatus @default(DRAFT)
  createdById String          @map("created_by_id")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  createdBy  User                 @relation(fields: [createdById], references: [id], onDelete: Cascade)
  items      ChangelogItem[]
  recipients ChangelogRecipient[]

  @@index([status])
  @@map("changelogs")
}

/// Um bloco de conteúdo dentro do e-mail (título + texto + imagem opcional
/// embutida no corpo, não anexo). Posição controla a ordem de exibição.
model ChangelogItem {
  id          String  @id @default(cuid())
  changelogId String  @map("changelog_id")
  title       String
  body        String
  imageUrl    String? @map("image_url")
  position    Int     @default(0)

  changelog Changelog @relation(fields: [changelogId], references: [id], onDelete: Cascade)

  @@index([changelogId, position])
  @@map("changelog_items")
}

/// Destinatário de um envio — `userId` nulo quando o e-mail foi colado
/// manualmente pelo admin em vez de selecionado de um usuário existente.
model ChangelogRecipient {
  id           String                   @id @default(cuid())
  changelogId  String                   @map("changelog_id")
  email        String
  userId       String?                  @map("user_id")
  status       ChangelogRecipientStatus @default(PENDING)
  errorMessage String?                  @map("error_message")
  sentAt       DateTime?                @map("sent_at")
  createdAt    DateTime                 @default(now()) @map("created_at")

  changelog Changelog @relation(fields: [changelogId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([changelogId, email])
  @@index([changelogId, status])
  @@map("changelog_recipients")
}
