enum CrmProposalSectionType {
  COVER
  COMPANY_PRESENTATION
  CLIENT_NEEDS
  SOLUTION
  SCOPE
  PRODUCTS_PRICING
  COMMERCIAL_TERMS
  TERMS_CONDITIONS
  SIGNATURE
}

enum CrmProposalStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
}

/// Template reutilizável de proposta: define quais das 9 seções de layout fixo
/// vêm habilitadas por padrão e o conteúdo boilerplate de cada uma. Uma
/// proposta pode ser gerada a partir de um template ou do zero.
model CrmProposalTemplate {
  id          String    @id @default(cuid())
  name        String
  description String?
  logoUrl     String?   @map("logo_url")
  workspaceId String    @map("workspace_id")
  createdById String    @map("created_by_id")
  updatedById String?   @map("updated_by_id")
  position    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  workspace Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User                         @relation("CrmProposalTemplateCreatedBy", fields: [createdById], references: [id])
  updatedBy User?                        @relation("CrmProposalTemplateUpdatedBy", fields: [updatedById], references: [id])
  sections  CrmProposalTemplateSection[]
  proposals CrmProposal[]

  @@index([workspaceId])
  @@index([deletedAt])
  @@index([workspaceId, position])
  @@map("crm_proposal_templates")
}

/// Uma das 9 seções de layout fixo dentro de um template. `defaultContent`
/// segue o mesmo shape (discriminado por `type`) validado por Zod na service.
model CrmProposalTemplateSection {
  id             String                 @id @default(cuid())
  templateId     String                 @map("template_id")
  type           CrmProposalSectionType
  order          Int                    @default(0)
  enabled        Boolean                @default(true)
  defaultContent Json?                  @map("default_content")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  template CrmProposalTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, type])
  @@index([templateId])
  @@map("crm_proposal_template_sections")
}

/// Documento de proposta com layout fixo (seções travadas), escopado por
/// workspace e opcionalmente vinculado a cliente/contato/oportunidade.
/// `shareToken` opaco serve a página pública sem autenticação.
model CrmProposal {
  id            String            @id @default(cuid())
  name          String
  templateId    String?           @map("template_id")
  companyId     String?           @map("company_id")
  contactId     String?           @map("contact_id")
  opportunityId String?           @map("opportunity_id")
  responsibleId String            @map("responsible_id")
  validUntil    DateTime?         @map("valid_until")
  status        CrmProposalStatus @default(DRAFT)
  shareToken    String            @unique @map("share_token")
  workspaceId   String            @map("workspace_id")
  createdById   String            @map("created_by_id")
  updatedById   String?           @map("updated_by_id")
  position      Int               @default(0)
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  deletedAt     DateTime?         @map("deleted_at")

  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  template    CrmProposalTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  company     CrmCompany?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact     CrmPerson?           @relation("CrmProposalContact", fields: [contactId], references: [id], onDelete: SetNull)
  opportunity CrmOpportunity?      @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  responsible User                 @relation("CrmProposalResponsible", fields: [responsibleId], references: [id])
  createdBy   User                 @relation("CrmProposalCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?                @relation("CrmProposalUpdatedBy", fields: [updatedById], references: [id])
  sections    CrmProposalSection[]
  views       CrmProposalView[]

  @@index([workspaceId])
  @@index([templateId])
  @@index([companyId])
  @@index([opportunityId])
  @@index([status])
  @@index([deletedAt])
  @@index([workspaceId, position])
  @@map("crm_proposals")
}

/// Uma das 9 seções de layout fixo dentro de uma proposta. `content` segue um
/// shape estruturado por `type` (discriminated union no Zod), nunca HTML livre.
model CrmProposalSection {
  id         String                 @id @default(cuid())
  proposalId String                 @map("proposal_id")
  type       CrmProposalSectionType
  order      Int                    @default(0)
  enabled    Boolean                @default(true)
  content    Json
  createdAt  DateTime               @default(now()) @map("created_at")
  updatedAt  DateTime               @updatedAt @map("updated_at")

  proposal CrmProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, type])
  @@index([proposalId])
  @@map("crm_proposal_sections")
}

/// Beacon de visualização anônima de uma proposta pública (LGPD: IP com hash).
model CrmProposalView {
  id          String   @id @default(cuid())
  proposalId  String   @map("proposal_id")
  viewId      String   @map("view_id")
  ipHash      String   @map("ip_hash")
  durationMs  Int      @default(0) @map("duration_ms")
  reachedEnd  Boolean  @default(false) @map("reached_end")
  scrolledPct Int      @default(0) @map("scrolled_pct")
  referrer    String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  proposal CrmProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, viewId])
  @@index([proposalId])
  @@map("crm_proposal_views")
}

